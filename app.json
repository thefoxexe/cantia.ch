{
  "expo": {
    "name": "Cantia",
    "slug": "cantia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "cantia",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cantia utilise vos photos pour illustrer vos rapports de chantier.",
          "cameraPermission": "Cantia utilise l'appareil photo pour documenter vos chantiers."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cantia géolocalise vos photos de chantier pour vos rapports."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Cantia utilise le microphone pour la dictée vocale et vos messages vocaux de chantier.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#BC5A31"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ch.cantia.app"
    },
    "android": {
      "package": "ch.cantia.app",
      "adaptiveIcon": {
        "backgroundColor": "#7C3B21",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    }
  }
}
